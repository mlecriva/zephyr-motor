config PWM_BRIDGE_STM32
	bool "STM32 bridge output stage"
	default y
	depends on DT_HAS_ST_STM32_PWM_BRIDGE_ENABLED
	select PINCTRL
	select RESET
	select USE_STM32_LL_TIM
	help
	  Enable the bridge output stage driver for STM32 advanced-control
	  timers (TIM1/TIM8). Drives one to four half-bridge legs with hardware
	  dead-time on a center-aligned carrier, and commits the state of every
	  leg atomically through a commutation event.
