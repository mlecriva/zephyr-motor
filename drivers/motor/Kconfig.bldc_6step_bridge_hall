config MOTOR_BLDC_6STEP_BRIDGE_HALL
	bool "6-step BLDC motor on pwm_bridge and bldc_hall"
	default y
	depends on DT_HAS_ZEPHYR_BLDC_6STEP_BRIDGE_HALL_ENABLED
	select PWM_BRIDGE
	select BLDC_HALL
	imply BLDC_ADC
	help
	  Enable the 6-step BLDC motor driver with Hall sensors. Commutates a
	  three-leg pwm_bridge from the edges of a bldc_hall device, and can
	  bind a bldc_adc sampler synchronized to the same bridge, all named
	  by phandle. Reports the shaft speed and angle from the Hall edges,
	  and the phase currents from the sampler, all raw. Holds no vendor
	  code.

if MOTOR_BLDC_6STEP_BRIDGE_HALL

config MOTOR_BLDC_6STEP_BRIDGE_HALL_ADC_CALIB_SAMPLES
	int "Zero-current calibration samples"
	default 16
	range 1 32
	help
	  Number of conversions averaged per phase during the boot
	  zero-current offset calibration, when an adc is bound. Higher values
	  reduce the residual offset noise at the cost of a longer boot
	  calibration. Only the offset is averaged: the phase currents
	  reported afterwards are single samples.

endif # MOTOR_BLDC_6STEP_BRIDGE_HALL
